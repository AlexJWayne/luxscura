{
	"name": "luxscura-workspace",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun --filter luxscura build",
		"test": "bun --filter luxscura test",
		"typecheck": "bun --filter luxscura typecheck",
		"check": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7"
	},
	"overrides": {
		"typescript": "npm:tsover@6.0.2"
	},
	"packageManager": "bun@1.3.10"
}
