{
	"name": "luxscura",
	"version": "0.0.0",
	"description": "A TypeGPU ray marching renderer",
	"license": "MIT",
	"author": "Alex Wayne",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./pbr": {
			"types": "./dist/appearances/pbr/index.d.ts",
			"import": "./dist/pbr.js",
			"default": "./dist/pbr.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"typegpu": "^0.12.6"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@webgpu/types": "^0.1.69",
		"typegpu": "^0.12.6",
		"typescript": "npm:tsover@6.0.2",
		"unplugin-typegpu": "^0.12.4",
		"vite": "^8.0.0"
	}
}
